{
  "name": "mosaic",
  "version": "1.0.0",
  "description": "Open source React Design System Monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Sirley Almeida",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm storybook",
    "storybook": "pnpm --filter @mosaic/storybook storybook",
    "build": "pnpm --filter \"@mosaic-ds/*\" build",
    "build:tokens": "pnpm --filter @mosaic-ds/tokens build",
    "build:react": "pnpm --filter @mosaic-ds/react build",
    "visual:build": "pnpm build:tokens && pnpm --filter @mosaic/storybook build-storybook",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "test": "vitest run",
    "test:watch": "pnpm --filter @mosaic-ds/react test:watch",
    "typecheck": "pnpm --filter \"@mosaic-ds/*\" exec tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.11.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}