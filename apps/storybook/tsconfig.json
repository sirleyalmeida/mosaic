{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@mosaic/react": ["../../packages/react/src/index.ts"],
      "@mosaic/react/*": ["../../packages/react/src/*"]
    }
  },
  "include": [
    "src/**/*",
    ".storybook/**/*",
    "../../packages/react/src/**/*"
  ],
}